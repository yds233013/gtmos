# GTMOS configuration. Copy to .env and adjust. Nothing here is required for the demo:
# with no keys set, every integration runs in clearly-labeled DEMO/SIMULATED mode.

# --- Core ---------------------------------------------------------------------------------------
ENV=development
# Local dev (make dev) uses the docker-compose Postgres on host port 56432.
DATABASE_URL=postgresql+psycopg://gtmos:gtmos@localhost:56432/gtmos
# Leave unset to run workflow jobs inline; set with QUEUE_BACKEND=redis to use the RQ worker.
# REDIS_URL=redis://localhost:56379/0
QUEUE_BACKEND=inline
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]
SEED_ACCOUNTS=2000

# --- Security boundary ---------------------------------------------------------------------------
# When set, ICP changes and live CRM writes require `Authorization: Bearer <token>`. Required in production.
# ADMIN_API_TOKEN=
# HMAC secret for inbound webhooks (n8n / generic / PostHog token header). Required in production.
# WEBHOOK_SECRET=

# --- LLM (optional) -------------------------------------------------------------------------------
# Live research generation needs BOTH a key and LLM_ENABLED=true (a key alone never triggers billed calls).
# ANTHROPIC_API_KEY=
LLM_ENABLED=false
LLM_MODEL=claude-opus-5

# --- HubSpot (optional) ---------------------------------------------------------------------------
# Private-app token with crm.objects.companies/contacts/deals read+write and crm.schemas write scopes.
# HUBSPOT_ACCESS_TOKEN=
# Live writes stay off until you explicitly enable them.
HUBSPOT_LIVE_WRITES_ENABLED=false
# App client secret, used to verify X-HubSpot-Signature-v3 on inbound webhooks.
# HUBSPOT_WEBHOOK_CLIENT_SECRET=

# --- Enrichment (optional) ------------------------------------------------------------------------
# APOLLO_API_KEY=

# --- Frontend -------------------------------------------------------------------------------------
API_INTERNAL_URL=http://127.0.0.1:8010

# Not required; listed so every Settings field has a home here.
LOG_LEVEL=INFO
# Outbound sending is a modelled constraint, not a capability: there is no SMTP client in this
# codebase, so this flag gates the *simulation*, never a real send.
OUTBOUND_SEND_ENABLED=false
# Clay (optional). Without these the Clay boundary stays a locally exercised contract.
# CLAY_API_KEY=
# CLAY_WEBHOOK_SECRET=

# --- Public demo -------------------------------------------------------------------------------
# Refuse every write at the edge. Set this to true ONLY on a publicly reachable demo instance:
# of the API's 36 mutating routes, four are admin-gated, two carry a gate that does nothing unless
# live writes are on, and the remaining 30 have no gate at all — which is fine
# on a laptop and not fine on the internet. Reads, the ICP preview, the routing simulator and the
# copilot still work. Leave unset locally.
READ_ONLY=false
