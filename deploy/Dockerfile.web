# GTMOS web, built from the REPOSITORY ROOT as context. See deploy/Dockerfile.api for why.
FROM node:24-alpine AS deps
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:24-alpine AS build
WORKDIR /app
# Rewrites (browser → /api/v1 → FastAPI) are resolved at build time, so the API host is a build arg.
# On Railway this is the API service's private domain, which must therefore be known at build time.
ARG API_INTERNAL_URL=http://api:8000
ENV API_INTERNAL_URL=$API_INTERNAL_URL NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ ./
RUN npm run build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0
RUN addgroup -S gtmos && adduser -S gtmos -G gtmos
COPY --from=build /app/public ./public
COPY --from=build --chown=gtmos:gtmos /app/.next/standalone ./
COPY --from=build --chown=gtmos:gtmos /app/.next/static ./.next/static
USER gtmos
EXPOSE 3000
# Next's standalone server reads $PORT, which Railway supplies.
CMD ["node", "server.js"]
